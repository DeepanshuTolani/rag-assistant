# Copy to .env (never commit .env). All values are read from environment variables.
GROQ_API_KEY=          # create a NEW key at console.groq.com (old keys were leaked -> revoke them)
#GROQ_MODEL=llama-3.3-70b-versatile   # any chat model available to your Groq account
GROQ_MODEL=openai/gpt-oss-120b
SECRET_KEY=          # long random string: python -c "import secrets;print(secrets.token_hex(32))"
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=500           # tokens
CHUNK_OVERLAP=50         # tokens
TOP_K=5
MIN_RETRIEVAL_SCORE=0.0  # 0 = gate off; calibrate with eval/run_eval.py
RERANK_MODEL=            # optional cross-encoder, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MIN=30
LLM_TIMEOUT_CONNECT=5
LLM_TIMEOUT_READ=60
LLM_MAX_RETRIES=3
LOG_DIR=logs
